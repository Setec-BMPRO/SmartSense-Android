<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.scan.ScanFragment">

    <!-- Header: logo + sensor count + overflow menu (always visible) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:contentInsetStart="@dimen/spacing_md"
        app:menu="@menu/menu_main">

        <include
            android:id="@+id/smartsense_logo"
            layout="@layout/layout_smartsense_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sensor_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            tools:text="5 sensors" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Scanning state (shown when no sensors connected) -->
    <LinearLayout
        android:id="@+id/scanning_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_xl">

        <!-- Bluetooth icon with pulse rings -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center">

            <com.smartsense.app.ui.views.PulseView
                android:id="@+id/pulse_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"/>

            <View
                android:id="@+id/scan_icon_circle"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_error"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/scan_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bluetooth_scan"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/nav_scan"/>
        </FrameLayout>

        <!-- Status text -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scan_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            tools:text="@string/scanning"/>

        <!-- Subtitle hint -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scan_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:text="@string/scan_auto_pair_hint"/>

        <!-- Bluetooth Settings button (shown on BLE error) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_bluetooth"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/open_bluetooth_settings"
            android:visibility="gone"
            app:icon="@drawable/ic_bluetooth_scan"
            app:iconGravity="textStart" />

        <!-- Help button (shown when no sensors are connected) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pair_help"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/help_pair_title"
            app:icon="@drawable/ic_question"
            app:iconGravity="textStart" />

    </LinearLayout>

    <!-- Connected sensors state (shown when sensors found) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_sensor" android:visibility="gone"
        android:layout_width="match_parent" android:fillViewport="true"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/filter_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="@string/filter_sensor_hint"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:endIconDrawable="@drawable/ic_close"
        app:endIconTint="?attr/colorOnSurfaceVariant"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/filter_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" android:imeOptions="actionDone"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

    </com.google.android.material.textfield.TextInputLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sensor_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:visibility="gone"
        tools:listitem="@layout/item_sensor_card"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer banner: pair-hint reminder, shown when at least one sensor is registered
         AND the user hasn't dismissed it (UserPreferences.pairHintDismissed). Tap text to
         open the "How to pair a sensor" dialog; tap the trailing X to hide permanently.
         Help menu in the toolbar remains as a re-entry point for the dialog after dismiss. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pair_hint_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:visibility="gone"
        app:cardBackgroundColor="#14D24520"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#4DD24520"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/pair_hint_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:src="@drawable/ic_question"
                app:tint="@color/primary"
                android:importantForAccessibility="no" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pair_hint_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/scan_auto_pair_hint" />

            <ImageButton
                android:id="@+id/pair_hint_dismiss"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:padding="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/cancel" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

