<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ui.detail.SensorDetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleCentered="true"
            app:subtitleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Primary Data Card (Status Dashboard) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- Battery -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/detail_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="92%"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAllCaps="true"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="?attr/colorOutlineVariant"/>

                    <!-- Quality -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/detail_quality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="Good"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/read_quality"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAllCaps="true"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="?attr/colorOutlineVariant"/>

                    <!-- Signal -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/detail_signal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="-45"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/signal_strength"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAllCaps="true"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tank Visualization Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_horizontal">

                <com.smartsense.app.ui.views.TankLevelView
                    android:id="@+id/detail_tank"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    app:isHorizontal="true"
                    app:isBiggerMode="false"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/last_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Updated just now"/>

                <!-- OFFLINE pill — flipped visible/gone by the per-second heartbeat in
                     SensorDetailFragment as soon as Sensor.isStale crosses the threshold
                     (15 s of silence for a 3 s reporting interval). Designed to be more
                     prominent than the toolbar-subtitle decoration. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:background="@drawable/bg_offline_pill"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textAllCaps="true"
                    android:visibility="gone"
                    android:text="@string/offline"
                    tools:visibility="visible"/>

                <!-- Automatic offline-cause caption, set by SensorDetailFragment from
                     Sensor.offlineCause. SCANNER_STALLED → app-side problem; SENSOR_QUIET →
                     sensor-side problem. Gone while online. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_cause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Sensor not responding"
                    tools:visibility="visible"/>
            </LinearLayout>

            <!-- Quality Warning Banner -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quality_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/bg_quality_warning"
                android:textColor="#B71C1C"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Low Quality: Tank empty or sensor is incorrectly positioned."
                tools:visibility="visible"/>

            <!-- Additional Info Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/additional_info"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true"
                android:paddingBottom="@dimen/spacing_sm"
                android:paddingStart="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_xs"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/additional_info_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/additional_info"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/additional_info_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:rotation="180"
                            android:src="@drawable/ic_expand_less"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="Toggle"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/additional_info_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="24dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Technical Detail Rows -->
                        <LinearLayout
                            android:id="@+id/detail_sensor_type_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sensor_type"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_sensor_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Std"/>
                        </LinearLayout>

                        <!-- Setec / Sigmawit only: protocol version -->
                        <LinearLayout
                            android:id="@+id/detail_protocol_version_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/protocol_version"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_protocol_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="0.1"/>
                        </LinearLayout>

                        <!-- Setec / Sigmawit only: software version -->
                        <LinearLayout
                            android:id="@+id/detail_software_version_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/software_version"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_software_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="1.0"/>
                        </LinearLayout>

                        <!-- Setec / Sigmawit only: reporting interval -->
                        <LinearLayout
                            android:id="@+id/detail_reporting_interval_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reporting_interval"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_reporting_interval"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="3 s"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_address"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_device_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="76:FC:54"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/height"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_height"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="141.3 mm"/>
                        </LinearLayout>

                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/detail_temperature_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/temperature"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_temperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="22.5°C"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_sm">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tank_type"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/detail_tank_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="20 lb (BBQ)"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Debug · Quality buffer
                 Shows the rolling window the ReadingQualityCalculator uses (mean, stddev,
                 sample list with per-sample deviation). Gated by the hidden Developer
                 Mode flag (Settings → tap version 7×) — `android:visibility="gone"` is the
                 default; SensorDetailFragment.observeViewModel flips it to VISIBLE while
                 the flag is on. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/debug_quality_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/debug_quality_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quality Buffer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/debug_quality_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:rotation="180"
                            android:src="@drawable/ic_expand_less"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="Toggle debug section"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/debug_quality_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="24dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/debug_quality_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:paddingTop="@dimen/spacing_sm"
                            tools:text="n=10  mean=141.3mm  σ=2.3mm  q=3"/>

                        <!-- Setec rolling counter — separate line so it doesn't push the
                             aggregate stats above onto two rows on narrow screens. Hidden
                             when the protocol doesn't expose a serial (CC2540 / NRF52). -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/debug_quality_serial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:paddingBottom="@dimen/spacing_sm"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="serial=42"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:layout_marginBottom="@dimen/spacing_sm"/>

                        <!-- Header row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="@dimen/spacing_xs">
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textAllCaps="true"
                                android:text="age"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:fontFamily="monospace"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textAllCaps="true"
                                android:gravity="end"
                                android:text="height (mm)"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:fontFamily="monospace"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textAllCaps="true"
                                android:gravity="end"
                                android:text="Δ from mean (mm)"/>
                        </LinearLayout>

                        <!-- Populated programmatically from the snapshot. -->
                        <LinearLayout
                            android:id="@+id/debug_quality_samples"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
